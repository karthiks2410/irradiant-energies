# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Screenshot dumps in repo root (Playwright captures, manual screenshots, etc).
# Scoped to repo root so legitimate images under public/ or src/ stay tracked.
/*.png
/*.jpg
/*.jpeg
# Old design-exploration mockup directory (kept on disk, never committed).
/.green-mockup/

# local agent / tooling artifacts
.claude/*
!.claude/skills/
.claude/skills/*/scripts/node_modules/
# Personal skills installed via uipro / external CLIs — keep local, not in repo.
.claude/skills/ui-ux-pro-max/
.claude/settings.local.json
.playwright-mcp/

.code-graph/*
!.code-graph/index.md